      }
    },
    {
      "id": "emma",
      "name": {
        "en": "Emma",
        "jp": "エマ"
      },
      "sprites": {
        "default": "/assets/characters/emma/ema.png",
        "emotions": {
          "normal": "/assets/characters/emma/ema.png",
          "smile": "/assets/characters/emma/ema.png",
          "happy": "/assets/characters/emma/ema.png",
          "kind": "/assets/characters/emma/ema.png",
          "angry": "/assets/characters/emma/ema.png",
          "sad": "/assets/characters/emma/ema.png",
          "surprised": "/assets/characters/emma/ema.png"
        },
        "outfits": {
          "uniform": {
            "default": "/assets/characters/emma/ema.png",
            "emotions": {
              "normal": "/assets/characters/emma/ema.png",
              "smile": "/assets/characters/emma/ema.png",
              "happy": "/assets/characters/emma/ema.png",
              "kind": "/assets/characters/emma/ema.png",
              "angry": "/assets/characters/emma/ema.png",
              "sad": "/assets/characters/emma/ema.png",
              "surprised": "/assets/characters/emma/ema.png"
            }
          },
          "casual": {
            "default": "/assets/characters/emma/ema.png",
            "emotions": {
              "normal": "/assets/characters/emma/ema.png",
              "smile": "/assets/characters/emma/ema.png",
              "happy": "/assets/characters/emma/ema.png",
              "kind": "/assets/characters/emma/ema.png",
              "angry": "/assets/characters/emma/ema.png",
              "sad": "/assets/characters/emma/ema.png",
              "surprised": "/assets/characters/emma/ema.png"
            }
          }
        }
      }
    }
  ],
  "script": [
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Hi! Are you new here?",
        "jp": "やあ！ここは初めて？"
      },
      "emotion": "smile",
      "position": "center"
    },
    {
      "type": "choice",
      "prompt": {
        "en": "How do you reply?",
        "jp": "どう返す？"
      },
      "options": [
        {
          "id": "polite",
          "text": {
            "en": "Yes, I'm new. Nice to meet you.",
            "jp": "はい、初めまして。"
          },
          "effects": {
            "affection": 2,
            "lesson_keys": ["greet_nice_to_meet_you"]
          },
          "goto": "emma_response_polite"
        },
        {
          "id": "casual",
          "text": {
            "en": "Yeah, just checking this place out. What's good around here?",
            "jp": "うん、ちょっと見に来ただけ。ここって何がいいの？"
          },
          "effects": {
            "affection": 1,
            "lesson_keys": ["casual_checking_out"]
          },
          "goto": "emma_response_casual"
        },
        {
          "id": "shy",
          "text": {
            "en": "Um... yes. Sorry, I'm a bit nervous.",
            "jp": "えっと…はい。ごめん、ちょっと緊張してて。"
          },
          "effects": {
            "affection": 1,
            "lesson_keys": ["express_nervous"]
          },
          "goto": "emma_response_shy"
        }
      ]
    },
    {
      "type": "label",
      "id": "emma_response_polite"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Nice to meet you too! I'm Emma. I'm an exchange student from the UK.",
        "jp": "初めまして！私はエマ。イギリスからの交換留学生なの。"
      },
      "emotion": "happy",
      "position": "center"
    },
    {
      "type": "goto",
      "target": "ask_about_drink"
    },
    {
      "type": "label",
      "id": "emma_response_casual"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Oh, cool! The coffee here is amazing. I'm Emma, by the way.",
        "jp": "へえ、いいね！ここのコーヒーは最高だよ。私はエマっていうの。"
      },
      "emotion": "smile",
      "position": "center"
    },
    {
      "type": "goto",
      "target": "ask_about_drink"
    },
    {
      "type": "label",
      "id": "emma_response_shy"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Aw, don't worry! Everyone's nervous on their first day. I'm Emma. Let me help you feel at home here!",
        "jp": "あら、心配しないで！初日はみんな緊張するものよ。私はエマ。ここに慣れるの手伝うね！"
      },
      "emotion": "kind",
      "position": "center"
    },
    {
      "type": "goto",
      "target": "ask_about_drink"
    },
    {
      "type": "label",
      "id": "ask_about_drink"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "So, do you like coffee or tea?",
        "jp": "それで、コーヒーと紅茶どっちが好き？"
      },
      "emotion": "normal",
      "position": "center"
    },
    {
      "type": "choice",
      "prompt": {
        "en": "What do you prefer?",
        "jp": "どちらが好き？"
      },
      "options": [
        {
          "id": "coffee",
          "text": {
            "en": "I love coffee! Especially lattes.",
            "jp": "コーヒーが大好き！特にラテ。"
          },
          "effects": {
            "affection": 1,
            "lesson_keys": ["express_preference_love"],
            "flags": {
              "favorite_drink": "coffee"
            }
          },
          "goto": "emma_coffee"
        },
        {
          "id": "tea",
          "text": {
            "en": "I prefer tea. It's more calming.",
            "jp": "紅茶の方が好き。落ち着くから。"
          },
          "effects": {
            "affection": 2,
            "lesson_keys": ["express_preference_prefer"],
            "flags": {
              "favorite_drink": "tea"
            }
          },
          "goto": "emma_tea"
        }
      ]
    },
    {
      "type": "label",
      "id": "emma_coffee"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Me too! I can't start my day without a good latte. We should grab one together sometime!",
        "jp": "私も！美味しいラテがないと一日が始まらないの。今度一緒に飲もうよ！"
      },
      "emotion": "excited",
      "position": "center"
    },
    {
      "type": "goto",
      "target": "end"
    },
    {
      "type": "label",
      "id": "emma_tea"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "Ah, a tea lover! That's very British of you. I approve! Let's have tea together soon.",
        "jp": "あら、お茶好きなんだ！とってもイギリス的ね。いいと思う！今度一緒にお茶しようよ。"
      },
      "emotion": "happy",
      "position": "center"
    },
    {
      "type": "label",
      "id": "end"
    },
    {
      "type": "say",
      "who": "emma",
      "text": {
        "en": "I think we're going to be great friends! See you around!",
        "jp": "私たち、いい友達になれそうね！またね！"
      },
      "emotion": "smile",
      "position": "center"
    },
    {
      "type": "end"
    }
  ]
}
